# Copy these into Vercel -> Project -> Settings -> Environment Variables.
# Leave the database ones empty to run the site in demo mode.

TOWN_NAME=Porchlight
IG_HANDLE=your_instagram_handle          # used for the "Get my house key" DM button
PUBLIC_SITE_URL=https://your-project.vercel.app

# Supabase -> Project Settings -> API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=                # sb_publishable_... (public, only used for live walking)
SUPABASE_SECRET_KEY=                     # sb_secret_... SECRET: server only, never in frontend code
# Older projects show "anon" and "service_role" keys instead; these names work too:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Long random string (16+ chars) to unlock /admin
ADMIN_SECRET=

# Instagram (fill in after Meta approves your app; the webhook stays off until then)
IG_APP_SECRET=
IG_ACCESS_TOKEN=
IG_VERIFY_TOKEN=
IG_API_VERSION=v21.0
